<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/public/styles.css" />
  </head>
  <body>
    <%
      // ナビは画面カタログ（src/lib/adminScreenCatalog.ts）から生成する。ここに直書きしない。
      // adminLocals ミドルウェアが res.locals.navGroups に注入済み。
      // カタログを使わないテスト等から include された場合に落ちないよう空配列で受ける。
      // （台帳を作った経緯のコメントは adminScreenCatalog.ts の先頭に移設した）
      const navGroups = Array.isArray(locals.navGroups) ? locals.navGroups.slice() : [];
      // アンケでYOTTO（hibi）運営画面への外部リンク群。env PORTAL_OPS_URL が未設定・
      // 非 http(s) なら空配列が返り、グループごと出ない（fail-closed。リンク切れを見せない）。
      // 同一タブ遷移。hibi 側の運営認可（allowlist・404）はそのまま効き、何もバイパスしない。
      const portalOpsLinks = typeof locals.portalOpsNavLinks === "function" ? locals.portalOpsNavLinks() : [];
      if (portalOpsLinks.length > 0) {
        navGroups.push({ label: "アンケでYOTTO", items: portalOpsLinks, external: true });
      }
      const activePath = typeof locals.currentPath === "string" ? locals.currentPath : "";
      // 「/admin/projects/xxx/edit」でも「プロジェクト」を現在地として点灯させる。
      // 外部リンク（絶対URL）は activePath と一致し得ないので点灯しない。
      const isActive = (href) => activePath === href || activePath.startsWith(href + "/");
    %>
    <header>
      <div class="header-bar">
        <a class="header-title" href="/admin">Hibi 管理画面</a>
        <%# header-bar は space-between。右側は1要素にまとめて配置を崩さない。
            グローバル検索もこの header-account の中に入れる（別要素として並べると
            space-between が3分割になりタイトルとアカウントの配置が崩れる）。 %>
        <div class="header-account">
          <%# 画面カタログのグローバル検索。LLM を使わず /admin/api/screen-search を引くだけ。
              候補クリックは同タブ遷移（ナビ操作なので新規タブにしない）。 %>
          <div class="header-search">
            <input
              type="search"
              id="screen-search-input"
              class="header-search-input"
              placeholder="画面・設定を検索"
              aria-label="画面・設定を検索"
              autocomplete="off"
            />
            <div id="screen-search-results" class="header-search-results" role="listbox" hidden></div>
          </div>
          <span class="header-user" title="ログイン中の管理者">
            <%= locals.adminUser || "admin" %>
          </span>
          <%# ログアウトは POST。GET だと画像タグ等でクロスサイトから強制ログアウトさせられる。 %>
          <form method="POST" action="/admin/logout" style="margin:0;">
            <button type="submit" class="header-logout" title="ログアウト">ログアウト</button>
          </form>
        </div>
      </div>
      <nav aria-label="管理メニュー">
        <a class="nav-home<%= activePath === "/admin" || activePath === "/admin/" ? " is-active" : "" %>" href="/admin">ダッシュボード</a>
        <% for (const group of navGroups) { %>
          <div class="nav-group">
            <span class="nav-group-label"><%= group.label %></span>
            <div class="nav-group-items">
              <% for (const item of group.items) { %>
                <a
                  href="<%= item.href %>"
                  class="<%= isActive(item.href) ? "is-active" : "" %><%= item.primary ? " is-primary" : "" %>"
                  <%- isActive(item.href) ? 'aria-current="page"' : "" %>
                ><%= item.label %><% if (item.badgeId) { %><span id="<%= item.badgeId %>" class="nav-badge" style="display:none"></span><% } %></a>
              <% } %>
            </div>
          </div>
        <% } %>
      </nav>
    </header>
    <script>
      // 申請中の交換申請件数をヘッダーの「交換申請」に通知バッジとして表示する
      (function () {
        fetch("/admin/exchange-requests/pending-count")
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (j) {
            if (!j || !j.count) return;
            var badge = document.getElementById("nav-exchange-badge");
            if (!badge) return;
            badge.textContent = j.count > 99 ? "99+" : String(j.count);
            badge.style.display = "";
          })
          .catch(function () { /* バッジは補助表示なので失敗しても無視 */ });
      })();

      // グローバル検索。入力するたびに /admin/api/screen-search を引いて候補を出す。
      // 画面カタログを引くだけ（LLM も DB も使わない）なので素朴に投げてよい。
      // URL はサーバーが返した値だけを使い、クライアントで組み立てない。
      (function () {
        var input = document.getElementById("screen-search-input");
        var box   = document.getElementById("screen-search-results");
        if (!input || !box) return;

        var timer = null;
        var seq = 0; // 後から投げた検索が先に返った古い結果に上書きされないようにする

        function close() {
          box.hidden = true;
          box.textContent = "";
        }

        function render(results) {
          box.textContent = "";
          if (!results || results.length === 0) {
            var empty = document.createElement("div");
            empty.className = "header-search-empty";
            empty.textContent = "該当する画面はありません";
            box.appendChild(empty);
            box.hidden = false;
            return;
          }
          for (var i = 0; i < results.length; i++) {
            var r = results[i];
            // 動的URL（:param 入り）は直接踏めないので候補から落とす。
            if (String(r.url).indexOf("/:") !== -1) continue;
            var a = document.createElement("a");
            a.className = "header-search-item";
            a.href = r.url; // サーバー計算値
            a.setAttribute("role", "option");

            var label = document.createElement("span");
            label.className = "header-search-item-label";
            label.textContent = r.label;
            a.appendChild(label);

            var meta = document.createElement("span");
            meta.className = "header-search-item-meta";
            var terms = (r.matchedTerms || []).slice(0, 2).join(" / ");
            meta.textContent = terms ? r.group + " · " + terms : r.group;
            a.appendChild(meta);

            box.appendChild(a);
          }
          box.hidden = box.childElementCount === 0;
        }

        function search() {
          var q = input.value.trim();
          if (q.length === 0) { close(); return; }
          var mine = ++seq;
          fetch("/admin/api/screen-search?q=" + encodeURIComponent(q))
            .then(function (res) { return res.ok ? res.json() : null; })
            .then(function (json) {
              if (mine !== seq) return; // 古いレスポンスは捨てる
              render(json && json.results);
            })
            .catch(function () { /* 検索は補助機能なので失敗しても黙って閉じる */ close(); });
        }

        input.addEventListener("input", function () {
          if (timer) clearTimeout(timer);
          timer = setTimeout(search, 150);
        });
        input.addEventListener("focus", function () {
          if (input.value.trim().length > 0) search();
        });
        input.addEventListener("keydown", function (e) {
          if (e.key === "Escape") { close(); input.blur(); return; }
          // Enter は先頭候補へ同タブ遷移
          if (e.key === "Enter") {
            var first = box.querySelector(".header-search-item");
            if (first) { e.preventDefault(); window.location.href = first.getAttribute("href"); }
          }
        });
        // 外側クリックで閉じる。候補のクリック（同タブ遷移）より先に閉じないよう mousedown は使わない。
        document.addEventListener("click", function (e) {
          if (!box.hidden && !box.contains(e.target) && e.target !== input) close();
        });
      })();

      // 横スクロール対策。テーブルを持つビューは59あるが .table-scroll で包んでいたのは
      // 5つだけだった。全ビューを個別に書き換える代わりにここで一括ラップする。
      document.addEventListener("DOMContentLoaded", function () {
        var tables = document.querySelectorAll("main table");
        for (var i = 0; i < tables.length; i++) {
          var table = tables[i];
          var parent = table.parentElement;
          if (parent && parent.classList.contains("table-scroll")) continue;
          // ネストしたテーブル（外側が既にラップ済み）は触らない
          if (table.closest(".table-scroll")) continue;
          var wrap = document.createElement("div");
          wrap.className = "table-scroll";
          parent.insertBefore(wrap, table);
          wrap.appendChild(table);
        }
      });
    </script>
    <main>
      <% if (locals.adminFlash) { %>
        <div class="flash flash-<%= locals.adminFlash.type %>" role="status">
          <span class="flash-message"><%= locals.adminFlash.message %></span>
          <button type="button" class="flash-close" aria-label="閉じる" onclick="this.parentElement.remove()">×</button>
        </div>
      <% } %>
