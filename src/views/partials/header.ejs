<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="<%= typeof locals.assetUrl === 'function' ? locals.assetUrl('styles.css') : '/public/styles.css' %>" />
  </head>
  <body>
    <%
      // ナビは画面カタログ（src/lib/adminScreenCatalog.ts）から生成する。ここに直書きしない。
      // adminLocals ミドルウェアが res.locals.navGroups に注入済み。
      // カタログを使わないテスト等から include された場合に落ちないよう空配列で受ける。
      // （台帳を作った経緯のコメントは adminScreenCatalog.ts の先頭に移設した）
      const navGroups = Array.isArray(locals.navGroups) ? locals.navGroups.slice() : [];
      // アンケでYOTTO（hibi）運営画面への外部リンク群。env PORTAL_OPS_URL が未設定・
      // 非 http(s) なら空配列が返り、グループごと出ない（fail-closed。リンク切れを見せない）。
      // 同一タブ遷移。hibi 側の運営認可（allowlist・404）はそのまま効き、何もバイパスしない。
      const portalOpsLinks = typeof locals.portalOpsNavLinks === "function" ? locals.portalOpsNavLinks() : [];
      if (portalOpsLinks.length > 0) {
        navGroups.push({ label: "アンケでYOTTO", items: portalOpsLinks, external: true });
      }
      // 「よく使う」外出し列。adminLocals が注入する（台帳の pinned:true）。
      const pinnedNavItems = Array.isArray(locals.pinnedNavItems) ? locals.pinnedNavItems : [];
      // 「すべての画面」パネル用。adminLocals が注入する（動的URL画面は含まれない）。
      const screenDirectory = Array.isArray(locals.screenDirectory) ? locals.screenDirectory : [];
      const activePath = typeof locals.currentPath === "string" ? locals.currentPath : "";
      // 「/admin/projects/xxx/edit」でも「プロジェクト」を現在地として点灯させる。
      // 外部リンク（絶対URL）は activePath と一致し得ないので点灯しない。
      const isActive = (href) => activePath === href || activePath.startsWith(href + "/");
      // グループのどれかが現在地なら、そのドロップダウンのボタン自体も点灯させる。
      // 畳んだ状態でも「今どこにいるか」が閉じたまま分かるようにするため。
      const groupHasActive = (group) => !group.external && group.items.some((i) => isActive(i.href));
    %>
    <header>
      <div class="header-bar">
        <a class="header-title" href="/admin">Hibi 管理画面</a>
        <%# header-bar は space-between。右側は1要素にまとめて配置を崩さない。
            グローバル検索もこの header-account の中に入れる（別要素として並べると
            space-between が3分割になりタイトルとアカウントの配置が崩れる）。 %>
        <div class="header-account">
          <%# 画面カタログのグローバル検索。LLM を使わず /admin/api/screen-search を引くだけ。
              候補クリックは同タブ遷移（ナビ操作なので新規タブにしない）。 %>
          <%# 「すべての画面」パネルを開く。ナビは近道、こちらは全体像。
              aria-controls で対応するパネルを示す。 %>
          <button
            type="button"
            id="screen-directory-open"
            class="header-directory-btn"
            aria-expanded="false"
            aria-controls="screen-directory"
            title="すべての画面"
          ><span aria-hidden="true">▦</span> すべての画面</button>
          <div class="header-search">
            <input
              type="search"
              id="screen-search-input"
              class="header-search-input"
              placeholder="画面・設定を検索"
              aria-label="画面・設定を検索"
              autocomplete="off"
            />
            <div id="screen-search-results" class="header-search-results" role="listbox" hidden></div>
          </div>
          <span class="header-user" title="ログイン中の管理者">
            <%= locals.adminUser || "admin" %>
          </span>
          <%# ログアウトは POST。GET だと画像タグ等でクロスサイトから強制ログアウトさせられる。 %>
          <form method="POST" action="/admin/logout" style="margin:0;">
            <button type="submit" class="header-logout" title="ログアウト">ログアウト</button>
          </form>
        </div>
      </div>
      <%# ナビは2段。
          1段目 = ダッシュボード＋「よく使う」ピン留め（毎日通る画面。1クリックで行ける）。
          2段目 = 業務グループごとのドロップダウン（39項目が5行に展開されて画面の1/3を
                  占めていたのを畳む）。**全リンクは畳んだ状態でも DOM に存在する**ので、
                  検索・スクリーンリーダー・既存のナビ到達性テストはそのまま通る。 %>
      <nav aria-label="管理メニュー" class="nav-shell">
        <div class="nav-pinned">
          <a class="nav-home<%= activePath === "/admin" || activePath === "/admin/" ? " is-active" : "" %>" href="/admin">ダッシュボード</a>
          <% for (const item of pinnedNavItems) { %>
            <a
              href="<%= item.href %>"
              class="nav-pin<%= isActive(item.href) ? " is-active" : "" %><%= item.primary ? " is-primary" : "" %>"
              <%- isActive(item.href) ? 'aria-current="page"' : "" %>
            ><%= item.label %><% if (item.badgeId) { %><span id="<%= item.badgeId %>" class="nav-badge" style="display:none"></span><% } %></a>
          <% } %>
        </div>
        <div class="nav-groups">
          <% for (const group of navGroups) { %>
            <div class="nav-group" data-nav-group>
              <%# details/summary ではなくボタン＋JSにするのは、外側クリックで閉じる・
                  他のメニューを閉じる・Escape で閉じるを素直に書けるため。
                  JS が動かなくても hidden 属性が付かないだけなので、最悪「全部開いた
                  状態」＝従来と同じ見た目に落ちる（到達性は失われない）。 %>
              <button
                type="button"
                class="nav-group-toggle<%= groupHasActive(group) ? " is-active" : "" %>"
                aria-expanded="false"
                data-nav-toggle
              ><%= group.label %><span class="nav-group-caret" aria-hidden="true">▾</span></button>
              <div class="nav-group-items" data-nav-menu hidden>
                <% for (const item of group.items) { %>
                  <a
                    href="<%= item.href %>"
                    class="<%= isActive(item.href) ? "is-active" : "" %><%= item.primary ? " is-primary" : "" %>"
                    <%- isActive(item.href) ? 'aria-current="page"' : "" %>
                  ><%= item.label %><% if (item.badgeId) { %><span id="<%= item.badgeId %>" class="nav-badge" style="display:none"></span><% } %></a>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </nav>
    </header>

    <%# ---- すべての画面パネル（右からスライドするドロワー） -------------------
        ナビが「よく使う近道」なのに対し、ここは画面カタログの全体像を出す場所。
        各画面の説明文（台帳の description）を添えるので、ナビの単なる複製にはならない。
        既定は hidden。JS が無い環境では開けないが、ナビと検索で到達性は確保済み。 %>
    <div id="screen-directory-overlay" class="directory-overlay" hidden></div>
    <aside
      id="screen-directory"
      class="directory-panel"
      aria-label="すべての画面"
      hidden
    >
      <div class="directory-head">
        <strong class="directory-title">すべての画面</strong>
        <button type="button" id="screen-directory-close" class="directory-close" aria-label="閉じる">×</button>
      </div>
      <div class="directory-filter">
        <input
          type="search"
          id="screen-directory-filter"
          class="directory-filter-input"
          placeholder="画面名で絞り込む"
          aria-label="画面名で絞り込む"
          autocomplete="off"
        />
      </div>
      <div class="directory-body">
        <% for (const group of screenDirectory) { %>
          <section class="directory-group" data-directory-group>
            <h2 class="directory-group-label"><%= group.label %></h2>
            <ul class="directory-list">
              <% for (const entry of group.entries) { %>
                <li class="directory-item" data-directory-item data-label="<%= entry.label %>">
                  <a
                    class="directory-link<%= isActive(entry.href) ? " is-active" : "" %>"
                    href="<%= entry.href %>"
                    <%- isActive(entry.href) ? 'aria-current="page"' : "" %>
                  >
                    <span class="directory-link-label"><%= entry.label %></span>
                    <span class="directory-link-desc"><%= entry.description %></span>
                  </a>
                  <% if (entry.children.length > 0) { %>
                    <ul class="directory-children">
                      <% for (const child of entry.children) { %>
                        <li><a class="directory-child" href="<%= child.href %>"><%= child.label %></a></li>
                      <% } %>
                    </ul>
                  <% } %>
                </li>
              <% } %>
            </ul>
          </section>
        <% } %>
        <p class="directory-empty" id="screen-directory-empty" hidden>該当する画面はありません</p>
      </div>
    </aside>
    <script>
      // 申請中の交換申請件数をヘッダーの「交換申請」に通知バッジとして表示する
      (function () {
        fetch("/admin/exchange-requests/pending-count")
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (j) {
            if (!j || !j.count) return;
            var badge = document.getElementById("nav-exchange-badge");
            if (!badge) return;
            badge.textContent = j.count > 99 ? "99+" : String(j.count);
            badge.style.display = "";
          })
          .catch(function () { /* バッジは補助表示なので失敗しても無視 */ });
      })();

      // ナビのグループドロップダウン。開いているのは常に1つだけ。
      // 進行性強化: この JS が動かなくても hidden 付きで畳まれたまま……にはならず、
      // hidden はサーバーが付けているので JS 無効時は閉じっぱなしになる。
      // それでは到達できないので、ここで最初に「JS が動いている」印を付け、
      // CSS 側は .js-nav が付いていないときだけメニューを強制表示する。
      (function () {
        var shell = document.querySelector(".nav-shell");
        if (!shell) return;
        shell.classList.add("js-nav");

        var groups = [].slice.call(shell.querySelectorAll("[data-nav-group]"));

        function closeAll(except) {
          for (var i = 0; i < groups.length; i++) {
            var g = groups[i];
            if (g === except) continue;
            var t = g.querySelector("[data-nav-toggle]");
            var m = g.querySelector("[data-nav-menu]");
            if (!t || !m) continue;
            m.hidden = true;
            t.setAttribute("aria-expanded", "false");
          }
        }

        for (var i = 0; i < groups.length; i++) {
          (function (group) {
            var toggle = group.querySelector("[data-nav-toggle]");
            var menu = group.querySelector("[data-nav-menu]");
            if (!toggle || !menu) return;
            toggle.addEventListener("click", function () {
              var willOpen = menu.hidden;
              closeAll(group);
              menu.hidden = !willOpen;
              toggle.setAttribute("aria-expanded", willOpen ? "true" : "false");
            });
          })(groups[i]);
        }

        // 外側クリックで閉じる。リンククリックはそのまま遷移するので邪魔しない。
        document.addEventListener("click", function (e) {
          if (!shell.contains(e.target)) closeAll(null);
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") closeAll(null);
        });
      })();

      // 「すべての画面」パネル。右からスライドして台帳の全体像を出す。
      // 中身はサーバーが描画済みなので、ここは開閉と絞り込みだけ。
      (function () {
        var openBtn  = document.getElementById("screen-directory-open");
        var panel    = document.getElementById("screen-directory");
        var overlay  = document.getElementById("screen-directory-overlay");
        var closeBtn = document.getElementById("screen-directory-close");
        var filter   = document.getElementById("screen-directory-filter");
        var empty    = document.getElementById("screen-directory-empty");
        if (!openBtn || !panel || !overlay || !closeBtn) return;

        var lastFocused = null;

        function open() {
          lastFocused = document.activeElement;
          panel.hidden = false;
          overlay.hidden = false;
          openBtn.setAttribute("aria-expanded", "true");
          // 背後がスクロールするとパネル内を読んでいる最中に本文が動いて紛らわしい
          document.body.style.overflow = "hidden";
          if (filter) filter.focus();
        }

        function close() {
          panel.hidden = true;
          overlay.hidden = true;
          openBtn.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
          // 開く前にフォーカスがあった場所へ戻す（キーボード操作で迷子にしない）
          if (lastFocused && typeof lastFocused.focus === "function") lastFocused.focus();
        }

        openBtn.addEventListener("click", function () {
          if (panel.hidden) open(); else close();
        });
        closeBtn.addEventListener("click", close);
        overlay.addEventListener("click", close);
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !panel.hidden) close();
        });

        // 名前で絞り込む。サーバーを引かずその場で隠すだけ。
        if (filter) {
          filter.addEventListener("input", function () {
            var q = filter.value.trim().toLowerCase();
            var items = panel.querySelectorAll("[data-directory-item]");
            var hitTotal = 0;
            for (var i = 0; i < items.length; i++) {
              var label = (items[i].getAttribute("data-label") || "").toLowerCase();
              var hit = q === "" || label.indexOf(q) !== -1;
              items[i].hidden = !hit;
              if (hit) hitTotal++;
            }
            // 中身が全部隠れたグループは見出しごと隠す
            var groups = panel.querySelectorAll("[data-directory-group]");
            for (var g = 0; g < groups.length; g++) {
              var visible = groups[g].querySelectorAll("[data-directory-item]:not([hidden])").length;
              groups[g].hidden = visible === 0;
            }
            if (empty) empty.hidden = hitTotal !== 0;
          });
        }
      })();

      // グローバル検索。入力するたびに /admin/api/screen-search を引いて候補を出す。
      // 画面カタログを引くだけ（LLM も DB も使わない）なので素朴に投げてよい。
      // URL はサーバーが返した値だけを使い、クライアントで組み立てない。
      (function () {
        var input = document.getElementById("screen-search-input");
        var box   = document.getElementById("screen-search-results");
        if (!input || !box) return;

        var timer = null;
        var seq = 0; // 後から投げた検索が先に返った古い結果に上書きされないようにする

        function close() {
          box.hidden = true;
          box.textContent = "";
        }

        function render(results) {
          box.textContent = "";
          if (!results || results.length === 0) {
            var empty = document.createElement("div");
            empty.className = "header-search-empty";
            empty.textContent = "該当する画面はありません";
            box.appendChild(empty);
            box.hidden = false;
            return;
          }
          for (var i = 0; i < results.length; i++) {
            var r = results[i];
            // 動的URL（:param 入り）は直接踏めないので候補から落とす。
            if (String(r.url).indexOf("/:") !== -1) continue;
            var a = document.createElement("a");
            a.className = "header-search-item";
            a.href = r.url; // サーバー計算値
            a.setAttribute("role", "option");

            var label = document.createElement("span");
            label.className = "header-search-item-label";
            label.textContent = r.label;
            a.appendChild(label);

            var meta = document.createElement("span");
            meta.className = "header-search-item-meta";
            var terms = (r.matchedTerms || []).slice(0, 2).join(" / ");
            meta.textContent = terms ? r.group + " · " + terms : r.group;
            a.appendChild(meta);

            box.appendChild(a);
          }
          box.hidden = box.childElementCount === 0;
        }

        function search() {
          var q = input.value.trim();
          if (q.length === 0) { close(); return; }
          var mine = ++seq;
          fetch("/admin/api/screen-search?q=" + encodeURIComponent(q))
            .then(function (res) { return res.ok ? res.json() : null; })
            .then(function (json) {
              if (mine !== seq) return; // 古いレスポンスは捨てる
              render(json && json.results);
            })
            .catch(function () { /* 検索は補助機能なので失敗しても黙って閉じる */ close(); });
        }

        input.addEventListener("input", function () {
          if (timer) clearTimeout(timer);
          timer = setTimeout(search, 150);
        });
        input.addEventListener("focus", function () {
          if (input.value.trim().length > 0) search();
        });
        input.addEventListener("keydown", function (e) {
          if (e.key === "Escape") { close(); input.blur(); return; }
          // Enter は先頭候補へ同タブ遷移
          if (e.key === "Enter") {
            var first = box.querySelector(".header-search-item");
            if (first) { e.preventDefault(); window.location.href = first.getAttribute("href"); }
          }
        });
        // 外側クリックで閉じる。候補のクリック（同タブ遷移）より先に閉じないよう mousedown は使わない。
        document.addEventListener("click", function (e) {
          if (!box.hidden && !box.contains(e.target) && e.target !== input) close();
        });
      })();

      // 横スクロール対策。テーブルを持つビューは59あるが .table-scroll で包んでいたのは
      // 5つだけだった。全ビューを個別に書き換える代わりにここで一括ラップする。
      document.addEventListener("DOMContentLoaded", function () {
        var tables = document.querySelectorAll("main table");
        for (var i = 0; i < tables.length; i++) {
          var table = tables[i];
          var parent = table.parentElement;
          if (parent && parent.classList.contains("table-scroll")) continue;
          // ネストしたテーブル（外側が既にラップ済み）は触らない
          if (table.closest(".table-scroll")) continue;
          var wrap = document.createElement("div");
          wrap.className = "table-scroll";
          parent.insertBefore(wrap, table);
          wrap.appendChild(table);
        }
      });
    </script>
    <main>
      <% if (locals.adminFlash) { %>
        <div class="flash flash-<%= locals.adminFlash.type %>" role="status">
          <span class="flash-message"><%= locals.adminFlash.message %></span>
          <button type="button" class="flash-close" aria-label="閉じる" onclick="this.parentElement.remove()">×</button>
        </div>
      <% } %>
