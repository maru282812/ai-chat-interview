<%# LIFF共通認証ユーティリティ - 全LIFF画面で LIFF SDK読み込み直後にincludeして使う
    window.LiffAuth を提供し、各画面は個別にliff.init()を書かない。

    使い方:
      const token = await LiffAuth.initLiffOrWebAuth(liffId);
      if (!token) return; // LINE Loginリダイレクト中
      // token を Authorization: Bearer として使う
%>
<script>
(function () {
  'use strict';

  var _initialized = false;

  function _log(msg, data) {
    try { console.log('[LiffAuth] ' + msg, data || {}); } catch (_e) {}
  }

  // --- 体感時間の計測（計測フェーズ専用・挙動非干渉） ---------------------
  // サーバーログに映らないクライアント側ウォーターフォール（SDKダウンロード＋liff.init）を
  // 回収する。モバイルの LINE 内ブラウザは DevTools が無いため、sendBeacon で
  // /liff/perf-beacon に送ってサーバーログに出す。目星が付いたら本ブロックごと撤去可。
  var _perf = { initMs: 0, sdkReadyMs: 0, reported: false };
  function _now() { try { return performance.now(); } catch (_e) { return 0; } }
  function _sdkReadyMs() {
    try {
      var e = performance.getEntriesByType('resource')
        .filter(function (r) { return String(r.name).indexOf('sdk.js') >= 0; })[0];
      return e ? Math.round(e.responseEnd * 10) / 10 : 0;
    } catch (_e) { return 0; }
  }
  function reportPerf(page, extra) {
    if (_perf.reported) return;
    _perf.reported = true;
    extra = extra || {};
    var body = {
      page: page || location.pathname,
      sdkReadyMs: _perf.sdkReadyMs || _sdkReadyMs(),
      initMs: _perf.initMs,
      authTotalMs: _now(),
      totalMs: _now(),
      dataMs: typeof extra.dataMs === 'number' ? extra.dataMs : undefined,
      renderMs: typeof extra.renderMs === 'number' ? extra.renderMs : undefined,
      inClient: (function () { try { return liff.isInClient(); } catch (_e) { return undefined; } })(),
    };
    _log('perf', body);
    try {
      var json = JSON.stringify(body);
      if (navigator.sendBeacon) {
        navigator.sendBeacon('/liff/perf-beacon', new Blob([json], { type: 'application/json' }));
      } else {
        fetch('/liff/perf-beacon', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: json, keepalive: true });
      }
    } catch (_e) { /* 計測がページを壊さないことを最優先 */ }
  }
  // ----------------------------------------------------------------------

  // LINE Login の戻りで付与される OAuth パラメータ。redirectUri に残したまま
  // 再ログインすると戻りURLに code/state が二重に付き、SDK の検証が失敗し続けて
  // LINE⇄サイトの無限リダイレクトループになるため、ログイン前に必ず除去する。
  var OAUTH_RESPONSE_PARAMS = ['code', 'state', 'error', 'error_description', 'liffClientId', 'liffRedirectUri'];
  // ログイン試行回数を URL で持ち回るパラメータ。WebView がストレージを保持しない
  // 環境（QR流入の in-app ブラウザ等）でもループガードが機能するよう、storage ではなく
  // redirectUri 自体に埋め込む。
  var RETRY_PARAM = 'liff_retry';
  var MAX_LOGIN_ATTEMPTS = 2;

  function _sanitizedUrl() {
    try {
      var u = new URL(location.href);
      for (var i = 0; i < OAUTH_RESPONSE_PARAMS.length; i++) {
        u.searchParams.delete(OAUTH_RESPONSE_PARAMS[i]);
      }
      return u;
    } catch (_e) {
      return null;
    }
  }

  function _loginAttemptCount() {
    try {
      return parseInt(new URL(location.href).searchParams.get(RETRY_PARAM) || '0', 10) || 0;
    } catch (_e) {
      return 0;
    }
  }

  /**
   * ループガード付き LINE Login リダイレクト。
   * redirectUri から前回の OAuth 残渣を除去し、試行回数を URL パラメータで持ち回る。
   * @returns {boolean} true = リダイレクト開始 / false = 試行上限（呼び出し側でエラー表示）
   */
  function loginWithGuard() {
    var attempt = _loginAttemptCount();
    if (attempt >= MAX_LOGIN_ATTEMPTS) {
      _log('login loop guard tripped', { attempt: attempt });
      return false;
    }
    var redirectUri = location.href;
    var u = _sanitizedUrl();
    if (u) {
      u.searchParams.set(RETRY_PARAM, String(attempt + 1));
      redirectUri = u.toString();
    }
    _log('redirecting to LINE Login', { attempt: attempt + 1, redirectUri: redirectUri });
    liff.login({ redirectUri: redirectUri });
    return true;
  }

  // --- スマホの通常ブラウザで開かれたときの LIFF への切り替え -------------------
  // LINE の in-app ブラウザやカメラアプリ経由のブラウザで開かれると LIFF ブラウザではない
  // ため Web 版 LINE Login の往復が必要になり、端末によっては戻り後もログイン済みに
  // ならずループガードで止まる（店舗QRで実際に発生）。スマホではログイン往復の前に
  // 「LINEで開く」（liff.line.me 恒久URL）を案内し、LIFF ブラウザで開き直してもらう。
  // リンクはタップで開かせる（JS の自動遷移だと iOS のユニバーサルリンクが効かない）。
  var HANDOFF_PARAM = 'liff_handoff';

  function _hasParam(name) {
    try { return new URL(location.href).searchParams.has(name); } catch (_e) { return false; }
  }

  function _safe(fn, fallback) {
    try { return fn(); } catch (_e) { return fallback; }
  }

  function _isMobileExternal() {
    var os = _safe(function () { return liff.getOS(); }, 'web');
    var inClient = _safe(function () { return liff.isInClient(); }, false);
    return !inClient && (os === 'ios' || os === 'android');
  }

  /**
   * ログイン往復の状態をサーバーログへ送る（/liff/auth-beacon → liff.auth.client）。
   * 外部ブラウザでログインが完了しない原因を実データで特定するための計測。
   */
  function _authBeacon(event, extra) {
    try {
      var u = new URL(location.href);
      var storageOk = _safe(function () {
        sessionStorage.setItem('__liff_auth_probe', '1');
        sessionStorage.removeItem('__liff_auth_probe');
        return true;
      }, false);
      var body = {
        event: event,
        page: location.pathname,
        attempt: _loginAttemptCount(),
        handoff: u.searchParams.has(HANDOFF_PARAM),
        hasCode: u.searchParams.has('code'),
        hasState: u.searchParams.has('state'),
        oauthError: u.searchParams.get('error') || undefined,
        oauthErrorDescription: (u.searchParams.get('error_description') || '').slice(0, 200) || undefined,
        isInClient: _safe(function () { return liff.isInClient(); }, undefined),
        isLoggedIn: _safe(function () { return liff.isLoggedIn(); }, undefined),
        os: _safe(function () { return liff.getOS(); }, undefined),
        sessionStorageOk: storageOk,
        cookieEnabled: navigator.cookieEnabled,
        referrerHost: _safe(function () { return document.referrer ? new URL(document.referrer).host : ''; }, ''),
        ua: navigator.userAgent.slice(0, 200),
      };
      if (extra) { for (var k in extra) { body[k] = extra[k]; } }
      _log('auth beacon', body);
      var json = JSON.stringify(body);
      if (navigator.sendBeacon) {
        navigator.sendBeacon('/liff/auth-beacon', new Blob([json], { type: 'application/json' }));
      } else {
        fetch('/liff/auth-beacon', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: json, keepalive: true });
      }
    } catch (_e) { /* 計測がページを壊さないことを最優先 */ }
  }

  /** 今のページを LIFF ブラウザで開き直す liff.line.me URL（作れなければ null） */
  async function _buildOpenInLineUrl(liffId) {
    var u = _sanitizedUrl();
    if (!u) return null;
    u.searchParams.delete(RETRY_PARAM);
    u.searchParams.delete('liff.state');
    u.searchParams.set(HANDOFF_PARAM, '1');
    try {
      if (liff.permanentLink && typeof liff.permanentLink.createUrlBy === 'function') {
        return await liff.permanentLink.createUrlBy(u.toString());
      }
    } catch (_e) { /* endpoint 外など。下の組み立てにフォールバック */ }
    // LIFF endpoint は {APP_BASE_URL}/liff（liffRoutes の玄関）なので /liff 以下をそのまま渡す
    if (u.pathname.indexOf('/liff') !== 0) return null;
    return 'https://liff.line.me/' + liffId + u.pathname.slice('/liff'.length) + u.search;
  }

  function _esc(v) {
    return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  /** 「LINEで開く」案内画面。ブラウザでのログインは試行上限まで選べる。 */
  function _renderOpenInLine(openUrl, opts) {
    var canBrowserLogin = _loginAttemptCount() < MAX_LOGIN_ATTEMPTS;
    var lead = opts.loginFailed
      ? 'このブラウザではLINEログインを完了できませんでした。'
      : opts.handoff
        ? 'LINEアプリに切り替えられませんでした。'
        : 'このページはLINEアプリで開くと、ログインなしでそのまま進めます。';
    var btn = 'display:block;width:100%;padding:14px;border-radius:12px;font-size:15px;font-weight:600;text-align:center;text-decoration:none;margin-top:14px;cursor:pointer;box-sizing:border-box;';
    document.body.innerHTML =
      '<div style="max-width:480px;margin:0 auto;padding:16px;font-family:-apple-system,BlinkMacSystemFont,\'Hiragino Sans\',\'Noto Sans JP\',sans-serif;">' +
        '<div style="background:#fff;border-radius:16px;padding:24px 20px;box-shadow:0 2px 8px rgba(0,0,0,.07);text-align:center;">' +
          '<div style="font-size:44px;margin-bottom:12px;">💬</div>' +
          '<h2 style="font-size:18px;font-weight:700;color:#1a2f2a;margin:0 0 8px;">LINEアプリで開いてください</h2>' +
          '<p style="font-size:14px;color:#60726f;line-height:1.7;margin:0;">' + _esc(lead) + '</p>' +
          (openUrl
            ? '<a id="liff-open-in-line" href="' + _esc(openUrl) + '" style="' + btn + 'background:#06c755;color:#fff;">LINEで開く</a>'
            : '') +
          '<p style="font-size:13px;color:#60726f;line-height:1.7;margin:16px 0 0;text-align:left;">' +
            'うまく開かない場合は、LINEアプリの「ホーム」→ 検索欄の横のQRアイコンから、QRコードを読み取り直してください。' +
          '</p>' +
          (canBrowserLogin
            ? '<button id="liff-browser-login" type="button" style="' + btn + 'background:#f0f4f3;color:#333;border:1px solid #d8e3e0;">このブラウザでログインする</button>'
            : '') +
        '</div>' +
      '</div>';
    var open = document.getElementById('liff-open-in-line');
    if (open) open.addEventListener('click', function () { _authBeacon('open_in_line_tap'); });
    var login = document.getElementById('liff-browser-login');
    if (login) {
      login.addEventListener('click', function () {
        login.disabled = true;
        _authBeacon('browser_login_tap');
        loginWithGuard();
      });
    }
  }

  /**
   * 未ログイン時の入口。スマホの通常ブラウザなら「LINEで開く」案内を出し、
   * それ以外（PC 等）はループガード付きで LINE Login へリダイレクトする。
   * @returns {boolean} true = 案内表示 or リダイレクト中 / false = 試行上限（呼び出し側でエラー表示）
   */
  async function promptOrLogin(liffId) {
    var attempt = _loginAttemptCount();
    var loginFailed = attempt > 0;
    _authBeacon(loginFailed ? 'login_return_not_logged_in' : 'not_logged_in');
    if (_isMobileExternal()) {
      var openUrl = await _buildOpenInLineUrl(liffId);
      _authBeacon('open_in_line_prompt', { hasOpenUrl: Boolean(openUrl) });
      _renderOpenInLine(openUrl, { loginFailed: loginFailed, handoff: _hasParam(HANDOFF_PARAM) });
      return true;
    }
    if (!loginWithGuard()) {
      _authBeacon('login_loop_guard');
      return false;
    }
    return true;
  }
  // ----------------------------------------------------------------------

  /** 認証成功後にアドレスバーから OAuth 残渣とリトライカウンタを消す */
  function _clearLoginResidue() {
    try {
      var u = _sanitizedUrl();
      if (!u) return;
      u.searchParams.delete(RETRY_PARAM);
      u.searchParams.delete(HANDOFF_PARAM);
      var next = u.toString();
      if (next !== location.href) history.replaceState(null, '', next);
    } catch (_e) { /* noop */ }
  }

  /**
   * LIFF初期化 + 未ログイン時はLINE Loginへリダイレクト。
   * スマホLINE内: LIFF認証 → IDトークン取得
   * PCブラウザ等: LINE Login OAuth → リダイレクト後に再実行 → IDトークン取得
   * @param {string} liffId
   * @returns {Promise<string|null>} IDトークン（リダイレクトが起きた場合はnull）
   */
  async function initLiffOrWebAuth(liffId) {
    _log('init start', {
      liffId: liffId,
      sdkLoaded: typeof liff !== 'undefined',
      url: location.href,
      ua: navigator.userAgent.slice(0, 150),
    });

    if (typeof liff === 'undefined') {
      throw new Error('LIFF SDKを読み込めませんでした。ページを再読み込みしてください。');
    }
    if (!liffId) {
      throw new Error('LIFF IDが設定されていません。管理者にお問い合わせください。');
    }

    if (!_initialized) {
      var _initStart = _now();
      await liff.init({ liffId: liffId });
      _perf.initMs = Math.round((_now() - _initStart) * 10) / 10;
      _perf.sdkReadyMs = _sdkReadyMs();
      _initialized = true;
    }

    var isInClient = liff.isInClient();
    var isLoggedIn = liff.isLoggedIn();
    var hasIdToken = Boolean(liff.getIDToken());

    _log('liff state', {
      hasIdToken: hasIdToken,
      isLoggedIn: isLoggedIn,
      isInClient: isInClient,
      currentPath: location.pathname,
    });

    if (!isLoggedIn) {
      if (!(await promptOrLogin(liffId))) {
        throw new Error('LINEログインを完了できませんでした。LINEアプリでQRコードを読み取り直すか、しばらくしてからもう一度お試しください。');
      }
      return null;
    }

    var token = liff.getIDToken();
    if (!token) {
      throw new Error('認証トークンを取得できませんでした。もう一度お試しください。');
    }

    // IDトークン失効対策。
    // LIFF は getIDToken() を自動更新しないため、ログインセッション(isLoggedIn)は
    // 残ったまま IDトークンだけ失効すると、上の未ログイン分岐に入らず失効トークンを
    // 使い続けてしまう（サーバー検証が 401 TOKEN_EXPIRED になり、LINEから開き直しても
    // セッションが生きているため直らない）。ここで exp を検査し、失効（間近）なら
    // 一度だけ再ログインして新しい IDトークンを取得する。
    try {
      var decoded = liff.getDecodedIDToken();
      var nowSec = Math.floor(Date.now() / 1000);
      if (decoded && decoded.exp && decoded.exp <= nowSec + 30) {
        _log('id token expired – recovering via re-login', { exp: decoded.exp, now: nowSec });
        if (handleTokenExpired()) return null; // logout+login でリダイレクト中
        // リトライ上限に達した場合は失効トークンのまま送信し、サーバー判定に委ねる
      } else {
        // 有効なトークンを取得できたので失効リトライガードを解除（次回の失効時に再回復可能に）
        try { sessionStorage.removeItem('liff_token_expired_retry'); } catch (_e) {}
      }
    } catch (_e) { /* decode 失敗時はそのまま送信しサーバー判定に委ねる */ }

    _log('auth ok', { isInClient: isInClient });
    // ログイン往復・LINE への切り替えを経た成功だけ記録（どの経路が効いたかの確認用）
    if (_loginAttemptCount() > 0 || _hasParam(HANDOFF_PARAM)) _authBeacon('auth_ok_after_retry');
    _clearLoginResidue();
    // 認証完了時点で SDK＋init の内訳を自動でビーコン送信（ページ側が reportPerf を
    // 呼ばなくても最低限クライアント側ウォーターフォールが測れるように）。
    // ページ側が dataMs/renderMs 付きで先に呼べばそちらが優先される（reported ガード）。
    setTimeout(function () { reportPerf(location.pathname); }, 1500);
    return token;
  }

  /** 最新のIDトークンを返す（initLiffOrWebAuth呼び出し後のみ有効） */
  function getCurrentAuthToken() {
    if (typeof liff === 'undefined' || !liff.isLoggedIn()) return null;
    return liff.getIDToken();
  }

  /**
   * 未認証ならLINE Loginへリダイレクト（画面ロード時の先行呼び出し用）。
   * initLiffOrWebAuth と同じ動作。
   */
  async function requireLoginIfNeeded(liffId) {
    return initLiffOrWebAuth(liffId);
  }

  /**
   * IdToken expired 時のリカバリー。
   * sessionStorage で 1 回まで制限（無限ループ防止）。
   * @returns {boolean} true = リダイレクト中, false = リトライ上限に達したため中断
   */
  function handleTokenExpired() {
    var KEY = 'liff_token_expired_retry';
    if (sessionStorage.getItem(KEY)) {
      return false;
    }
    sessionStorage.setItem(KEY, '1');
    try { liff.logout(); } catch (_e) {}
    // OAuth 残渣を除去した redirectUri ＋ 試行上限つきで再ログイン（無限ループ防止）
    return loginWithGuard();
  }

  /**
   * LIFFクライアント内なら closeWindow()、外なら history.back()。
   * 閉じるボタンの共通処理。
   */
  function closeOrBack() {
    try {
      if (typeof liff !== 'undefined' &&
          typeof liff.isInClient === 'function' &&
          liff.isInClient()) {
        liff.closeWindow();
        return;
      }
    } catch (_e) {}
    window.history.back();
  }

  window.LiffAuth = {
    initLiffOrWebAuth:    initLiffOrWebAuth,
    getCurrentAuthToken:  getCurrentAuthToken,
    requireLoginIfNeeded: requireLoginIfNeeded,
    handleTokenExpired:   handleTokenExpired,
    loginWithGuard:       loginWithGuard,
    promptOrLogin:        promptOrLogin,
    closeOrBack:          closeOrBack,
    reportPerf:           reportPerf,
  };
}());
</script>
