<%- include("../../partials/header", { title }) %>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
  <h2>繰り返しアンケート（離脱計測）</h2>
</div>

<% if (msg) { %>
  <div class="card" style="background:#e9f7f0;border:1px solid #2ca87a;color:#1c6e4f;padding:10px 14px;margin-bottom:1rem"><%= msg %></div>
<% } %>
<% if (err) { %>
  <div class="card" style="background:#fdecea;border:1px solid #b14;color:#8a1020;padding:10px 14px;margin-bottom:1rem"><%= err %></div>
<% } %>

<div class="card" style="padding:12px 14px;margin-bottom:1.2rem;background:#f7f8fa;border:1px solid #e2e5ea">
  <div style="font-size:13px;line-height:1.7;color:#444">
    <strong>離脱の定義</strong>：A（来店理由）で答えた<strong>来店頻度</strong>の期間を過ぎても、
    再来店（A の再回答）が無かった周を「離脱」とします。<br>
    次の A が来た時点で「離脱していない」が確定します。
    <strong>C に答えたかどうかは判定に使いません</strong>（C は離脱者に理由を聞くための調査です）。<br>
    <span style="color:#777">
      まだ期限が来ていない周（未確定）と、頻度が取れなかった周（判定不能）は
      <strong>離脱率の分母から除いています</strong>。分母が0のときは「—」と表示します。
    </span>
  </div>
</div>

<% if (rows.length === 0) { %>
  <div class="card" style="padding:24px;text-align:center;color:#777">
    サイクル定義がまだありません。<br>
    <span style="font-size:13px">
      美容室 A/B/C を登録するには <code>node scripts/seedSalonCycleGroup.mjs</code> を実行してください。
    </span>
  </div>
<% } %>

<% rows.forEach(function (row) { %>
  <div class="card" style="margin-bottom:1.5rem;padding:0;overflow:hidden">

    <div style="padding:12px 16px;border-bottom:1px solid #e2e5ea;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
      <div>
        <strong style="font-size:15px"><%= row.group.name %></strong>
        <% if (!row.group.is_enabled) { %>
          <span style="display:inline-block;background:#999;color:#fff;font-size:11px;padding:1px 7px;border-radius:3px;margin-left:6px">停止中</span>
        <% } %>
        <div style="font-size:12px;color:#777;margin-top:3px">
          クールダウン <%= row.group.restart_cooldown_days %>日 ／
          猶予 <%= row.group.grace_days %>日 ／
          頻度未定 <%= row.group.undecided_days %>日 ／
          B送信 <%= row.group.followup_b_delay_minutes %>分後
        </div>
      </div>
      <div style="text-align:right">
        <div style="font-size:26px;font-weight:600;color:<%= row.summary.churnRate === null ? '#999' : (row.summary.churnRate >= 0.5 ? '#b14' : '#2ca87a') %>">
          <%= formatChurnRate(row.summary.churnRate) %>
        </div>
        <div style="font-size:11px;color:#777">離脱率（確定 <%= row.summary.decided %> 周が分母）</div>
      </div>
    </div>

    <div style="padding:10px 16px;border-bottom:1px solid #eef0f3;font-size:12px;color:#555">
      <% row.steps.forEach(function (step, i) { %>
        <% if (i > 0) { %><span style="color:#bbb">→</span><% } %>
        <span style="display:inline-block;margin:0 4px">
          <span style="display:inline-block;background:<%= step.step_role === 'entry' ? '#2a6fb0' : (step.step_role === 'verify' ? '#c8851b' : '#666') %>;color:#fff;font-size:10px;padding:1px 6px;border-radius:3px">
            <%= step.step_role === 'entry' ? '起点' : (step.step_role === 'verify' ? '離脱検証' : '来店後') %>
          </span>
          <%= step.projectName %>
        </span>
      <% }) %>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:0;border-bottom:1px solid #eef0f3">
      <%
        const tiles = [
          { label: '総サイクル数', value: row.total,              color: '#333' },
          { label: '再来店',       value: row.summary.returned,   color: '#2ca87a' },
          { label: '離脱',         value: row.summary.churned,    color: '#b14' },
          { label: '未確定',       value: row.summary.pending,    color: '#999' },
          { label: '判定不能',     value: row.summary.unknown,    color: '#999' },
          { label: 'C送付待ち',    value: row.followupPending,    color: '#c8851b' }
        ];
      %>
      <% tiles.forEach(function (tile) { %>
        <div style="flex:1;min-width:110px;padding:12px 14px;border-right:1px solid #eef0f3">
          <div style="font-size:20px;font-weight:600;color:<%= tile.color %>"><%= tile.value %></div>
          <div style="font-size:11px;color:#777"><%= tile.label %></div>
        </div>
      <% }) %>
    </div>

    <% if (row.byCycleNo.length > 0) { %>
      <table style="width:100%;border-collapse:collapse;font-size:13px">
        <thead>
          <tr style="background:#fafbfc;color:#666;font-size:12px">
            <th style="text-align:left;padding:8px 16px;font-weight:600">周回</th>
            <th style="text-align:right;padding:8px 12px;font-weight:600">再来店</th>
            <th style="text-align:right;padding:8px 12px;font-weight:600">離脱</th>
            <th style="text-align:right;padding:8px 12px;font-weight:600">未確定</th>
            <th style="text-align:right;padding:8px 16px;font-weight:600">離脱率</th>
          </tr>
        </thead>
        <tbody>
          <% row.byCycleNo.forEach(function (bucket) { %>
            <tr style="border-top:1px solid #eef0f3">
              <td style="padding:8px 16px"><%= bucket.cycleNo %>周目</td>
              <td style="padding:8px 12px;text-align:right;color:#2ca87a"><%= bucket.summary.returned %></td>
              <td style="padding:8px 12px;text-align:right;color:#b14"><%= bucket.summary.churned %></td>
              <td style="padding:8px 12px;text-align:right;color:#999"><%= bucket.summary.pending %></td>
              <td style="padding:8px 16px;text-align:right;font-weight:600">
                <%= formatChurnRate(bucket.summary.churnRate) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div style="padding:20px 16px;text-align:center;color:#999;font-size:13px">
        まだ回答がありません。A のQRから回答されると、ここに周回が並びます。
      </div>
    <% } %>

    <details style="border-top:1px solid #e2e5ea">
      <summary style="padding:10px 16px;cursor:pointer;font-size:13px;font-weight:600;background:#fafbfc">
        ⚙ 配信タイミングの設定（Cをいつ送るか）
        <% if (!row.mapping.ok || !row.frequencyQuestionFound) { %>
          <span style="display:inline-block;background:#b14;color:#fff;font-size:11px;padding:1px 7px;border-radius:3px;margin-left:6px">要確認</span>
        <% } %>
      </summary>

      <div style="padding:14px 16px;border-top:1px solid #eef0f3">

        <div style="background:#f7f8fa;border:1px solid #e2e5ea;padding:10px 12px;font-size:12px;color:#555;line-height:1.7;margin-bottom:14px">
          <strong>Cの送付日 ＝ Aの回答日 ＋ 来店頻度の日数 ＋ 猶予日数</strong><br>
          例：「約2か月」＝<%= (row.daysTable['about_2m'] || 60) %>日 ＋ 猶予<%= row.group.grace_days %>日 →
          <strong>Aの回答から<%= (row.daysTable['about_2m'] || 60) + row.group.grace_days %>日後</strong>にCが届きます。<br>
          <span style="color:#777">※ その前にAが再回答された（＝再来店した）場合、Cは送られません。</span>
        </div>

        <% if (!row.frequencyQuestionFound) { %>
          <div style="background:#fdecea;border:1px solid #b14;color:#8a1020;padding:10px 12px;font-size:12px;margin-bottom:14px">
            <strong>⚠ 頻度設問「<%= row.group.frequency_question_code %>」が起点案件に見つかりません。</strong><br>
            この状態では<strong>誰にもCが送られません</strong>。設問コードを確認してください。
          </div>
        <% } else if (!row.mapping.ok) { %>
          <div style="background:#fdecea;border:1px solid #b14;color:#8a1020;padding:10px 12px;font-size:12px;margin-bottom:14px">
            <strong>⚠ 日数が設定されていない選択肢があります：<%= row.mapping.missingInTable.join(", ") %></strong><br>
            これらを選んだ人には<strong>Cが送られません</strong>（エラーにはなりません）。下の対応表に追加してください。
          </div>
        <% } %>

        <form method="post" action="/admin/cycles/<%= row.group.id %>">
          <div style="display:flex;flex-wrap:wrap;gap:14px;margin-bottom:14px">
            <label style="font-size:12px;color:#555">
              猶予日数<br>
              <input type="number" name="grace_days" min="0" value="<%= row.group.grace_days %>" style="width:90px;padding:5px">
              <div style="color:#888;font-size:11px">頻度期間に上乗せ</div>
            </label>
            <label style="font-size:12px;color:#555">
              頻度未定の人<br>
              <input type="number" name="undecided_days" min="1" value="<%= row.group.undecided_days %>" style="width:90px;padding:5px">
              <div style="color:#888;font-size:11px">「決まっていない」の日数</div>
            </label>
            <label style="font-size:12px;color:#555">
              クールダウン<br>
              <input type="number" name="restart_cooldown_days" min="0" value="<%= row.group.restart_cooldown_days %>" style="width:90px;padding:5px">
              <div style="color:#888;font-size:11px">A再訪で新周にする最短間隔</div>
            </label>
            <label style="font-size:12px;color:#555">
              B送信（分後）<br>
              <input type="number" name="followup_b_delay_minutes" min="0" value="<%= row.group.followup_b_delay_minutes %>" style="width:90px;padding:5px">
              <div style="color:#888;font-size:11px">0で送らない（QRのみ）</div>
            </label>
            <label style="font-size:12px;color:#555">
              頻度設問コード<br>
              <input type="text" name="frequency_question_code" value="<%= row.group.frequency_question_code %>" style="width:90px;padding:5px">
              <div style="color:#888;font-size:11px">起点案件の設問</div>
            </label>
          </div>

          <div style="margin-bottom:14px">
            <div style="font-size:12px;color:#555;margin-bottom:4px">
              来店頻度 → 日数の対応表（1行1件・<code>コード: 日数</code>）
            </div>
            <textarea name="frequency_days_table" rows="7" style="width:100%;max-width:420px;padding:6px;font-family:monospace;font-size:12px"><% Object.keys(row.daysTable).forEach(function (code) { %><%= code %>: <%= row.daysTable[code] %>
<% }) %></textarea>
            <% if (row.frequencyOptions.length > 0) { %>
              <div style="font-size:11px;color:#777;margin-top:5px">
                設問の選択肢：
                <% row.frequencyOptions.forEach(function (opt) { %>
                  <span style="display:inline-block;margin-right:8px;<%= row.mapping.missingInTable.includes(opt.value) ? 'color:#b14;font-weight:600' : '' %>">
                    <code><%= opt.value %></code>（<%= opt.label %>）
                  </span>
                <% }) %>
              </div>
            <% } %>
          </div>

          <label style="font-size:12px;color:#555;display:block;margin-bottom:12px">
            <input type="checkbox" name="is_enabled" <%= row.group.is_enabled ? 'checked' : '' %>>
            このサイクルを有効にする（外すとB/Cの自動送信が止まります）
          </label>

          <button type="submit" style="padding:7px 18px;background:#2a6fb0;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:13px">
            保存
          </button>
          <span style="font-size:11px;color:#888;margin-left:10px">
            ※ 既に確定している送付予定日は変わりません（次回A回答分から適用）
          </span>
        </form>
      </div>
    </details>

  </div>
<% }) %>

<%- include("../../partials/footer") %>
