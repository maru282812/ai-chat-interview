<%- include("../../partials/header", { title }) %>

<%
  // 設定の逆引き索引。データ源は画面カタログ（src/lib/adminScreenCatalog.ts）だけで、
  // DB は一切引かない。「この設定はどの画面でするのか」を目で追えるようにするのが目的。
  // 動的URL（:param を含むパス）はそのままでは踏めないので、リンクにせず注記を出す。
  const isDynamic = (path) => path.indexOf("/:") !== -1;
%>

<div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:1rem">
  <h2 style="margin:0">設定の索引</h2>
  <span style="font-size:12px;color:#789">
    <%= screenCount %> 画面 / <%= settingCount %> 設定項目
  </span>
</div>

<div class="card" style="margin-bottom:1rem">
  <p style="margin:0;font-size:13px;color:#567;line-height:1.7">
    「この設定はどの画面でするのか」の逆引き一覧です。ヘッダーの検索ボックスに
    設定項目名や別名（例:「離脱」「配信」）を入れても同じ台帳から候補が出ます。<br />
    <span style="color:#9aa">グレーの画面は一覧の行などから開く画面（URL に ID が必要）なので、直接のリンクはありません。</span>
  </p>
</div>

<% for (const group of groups) { %>
  <div class="card" style="margin-bottom:1rem">
    <h3 style="margin:0 0 12px;font-size:15px;border-bottom:2px solid #e6ecea;padding-bottom:6px">
      <%= group.label %>
    </h3>

    <% for (const screen of group.screens) { %>
      <div style="padding:10px 0;border-top:1px solid #f0f4f3">
        <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap">
          <% if (isDynamic(screen.path)) { %>
            <span style="font-weight:700;font-size:14px;color:#9aa"><%= screen.label %></span>
            <span style="font-size:11px;color:#9aa">（一覧から開く）</span>
          <% } else { %>
            <a href="<%= screen.path %>" style="font-weight:700;font-size:14px"><%= screen.label %></a>
          <% } %>
          <code style="font-size:11px;color:#9aa;font-family:monospace"><%= screen.path %></code>
        </div>

        <p style="margin:4px 0 0;font-size:12.5px;color:#567;line-height:1.6"><%= screen.description %></p>

        <% if (screen.settings.length > 0) { %>
          <ul style="margin:6px 0 0;padding-left:1.1em;font-size:12.5px;color:#345;line-height:1.8">
            <% for (const setting of screen.settings) { %>
              <li>
                <% if (isDynamic(screen.path)) { %>
                  <%= setting %>
                <% } else { %>
                  <a href="<%= screen.path %>"><%= setting %></a>
                <% } %>
              </li>
            <% } %>
          </ul>
        <% } else { %>
          <p style="margin:6px 0 0;font-size:12px;color:#9aa">（見るだけの画面。設定項目はありません）</p>
        <% } %>

        <% if (screen.synonyms.length > 0) { %>
          <div style="margin-top:6px">
            <% for (const synonym of screen.synonyms) { %>
              <span style="display:inline-block;font-size:11px;padding:1px 6px;border-radius:10px;margin:0 3px 3px 0;background:#eef4f3;color:#5a7"><%= synonym %></span>
            <% } %>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
<% } %>

<%- include("../../partials/footer") %>
